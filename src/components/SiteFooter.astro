---
import site from '../content/site.json';
import { visivel } from '../lib/jsonld';
import { redes as listarRedes } from '../lib/redes';
const { footer } = site;
// Instagram, Facebook, TikTok e Threads: só aparece o ícone da rede com link no painel
const redes = listarRedes(footer);
const linkStyle = "font-family:'Montserrat',sans-serif; font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:var(--areia); text-decoration:none;";
// `secao`: o objeto do conteúdo por trás do link. Seção desligada no painel
// tira o link do menu (aqui e no blog, que usa o mesmo rodapé).
const nav = [
  { href: '/#inicio', label: 'Início' },
  { href: '/#visao-sistemica', label: 'Visão Sistêmica', secao: 'visao' },
  { href: '/#quem-conduz', label: 'Quem conduz', secao: 'quemConduz' },
  { href: '/#jornadas', label: 'As Jornadas', secao: 'jornadas' },
  { href: '/blog', label: 'Blog' },
  { href: '/#faq', label: 'Perguntas frequentes', secao: 'faq' },
  { href: '/#convite', label: 'Contato' },
].filter((n) => !n.secao || visivel((site as any)[n.secao]));
---
<footer style="position:relative; z-index:2; background:var(--marrom-escuro); padding:52px 30px 64px; text-align:center;">
  <nav aria-label="Navegação do site" style="margin-bottom:34px;">
    <ul style="list-style:none; display:flex; flex-wrap:wrap; gap:14px 26px; justify-content:center; padding:0;">
      {nav.map((n) => (<li><a href={n.href} style={linkStyle}>{n.label}</a></li>))}
    </ul>
  </nav>
  {redes.length > 0 && (
  <ul aria-label="Redes sociais" style="list-style:none; display:flex; justify-content:center; gap:22px; padding:0;">
    {redes.map((r) => (
    <li><a href={r.url} target="_blank" rel="me noopener" aria-label={`${r.nome} da Taphiny (abre em nova aba)`} title={r.nome} style="display:block; color:var(--ouroc); line-height:0;">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" fill-rule="evenodd" aria-hidden="true" focusable="false"><path d={r.icone} /></svg>
    </a></li>
    ))}
  </ul>
  )}
  <div style="font-family:'Playfair Display',serif; font-weight:500; font-size:15px; letter-spacing:0.3em; color:var(--areia); margin-top:26px; padding-left:0.3em;">TAPHINY</div>
  <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:11px; letter-spacing:0.05em; color:var(--areia); margin-top:22px;">{footer.copyright}</p>
</footer>
