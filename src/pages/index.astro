---
import site from '../content/site.json';
import SiteFooter from '../components/SiteFooter.astro';
// Campos de prosa vêm do Tina como rich-text (árvore) e os curtos como texto
// simples; `t()` cuida dos dois e devolve o HTML inline. Ver src/lib/texto.ts.
import { inline as t, romano } from '../lib/texto';
import Bloco from '../components/Bloco.astro';
import VideoMidia from '../components/VideoMidia.astro';
import Esteira from '../components/Esteira.astro';
import { jsonLdHtml, visivel } from '../lib/jsonld';
const { seo, hero, provocacao, visao, quemConduz, comparacao, jornadas, paraQuem, faq, empresas, convite, config } = site;
const popup = (site as any).popup;
const constelacao = (site as any).constelacao;
const abordagem = (site as any).abordagem;

// FUNDOS ALTERNADOS pela ordem das seções VISÍVEIS: desligar uma seção nunca
// deixa duas vizinhas da mesma cor. Quem conduz (bordeaux) e Empresas (areia)
// têm cor própria; as demais alternam creme e rosa, começando em creme depois
// do topo e depois de cada seção de cor própria. Com todas ligadas, dá
// exatamente as cores de sempre. Topo e Convite ficam no marrom.
// PRÉVIA LOCAL: `PREVIA=empresas npm run dev` (ou várias chaves separadas por
// vírgula: `PREVIA=empresas,faq`) mostra seções desligadas sem mexer na chave
// do painel. Só vale no modo de desenvolvimento; o site publicado continua
// obedecendo só ao "Exibir no site". (Não dá para ser `?ver=` na URL: o Astro
// apaga os parâmetros da URL em página estática, até no dev.)
const previa = new Set(import.meta.env.DEV ? String(process.env.PREVIA || '').split(',').map((k) => k.trim()).filter(Boolean) : []);
const mostra = (k: string) => visivel((site as any)[k]) || previa.has(k);
const ORDEM_SECOES = ['provocacao', 'abordagem', 'visao', 'quemConduz', 'comparacao', 'constelacao', 'jornadas', 'paraQuem', 'faq', 'empresas'];
const COR_PROPRIA: Record<string, string> = { quemConduz: 'bordeaux', empresas: 'areia' };
const fundos: Record<string, string> = {};
{
  let anterior = 'marrom';
  for (const k of ORDEM_SECOES) {
    const secao = (site as any)[k];
    if (!secao || !mostra(k)) continue;
    anterior = fundos[k] = COR_PROPRIA[k] || (anterior === 'creme' ? 'rosa' : 'creme');
  }
}
const fundo = (k: string) => `background:var(--${fundos[k]});`;
// vídeo da constelação: sem link nem arquivo, a seção fica como sempre foi
const constVideo = !!(constelacao?.videoUrl?.trim() || constelacao?.video);
const FORMATOS: Record<string, string> = { horizontal: '16/9', vertical: '9/16', retrato: '4/5' };
const constFormato = constelacao?.videoFormato || 'horizontal';
const wa = (msg: string) => `https://wa.me/${config.whatsapp}?text=${encodeURIComponent(msg)}`;
// Modo blocado: seções longas fechadas, a pessoa abre a que quiser. O topo, a
// esteira de produtos (As Jornadas) e o convite final ficam sempre abertos.
const blocado = !!(config as any).secoesFechadas;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
