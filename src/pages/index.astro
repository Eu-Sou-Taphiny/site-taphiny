<!-- MOTOR DA ÁRVORE -->
<script is:inline>
(function(){
  "use strict";
  var HALF = Math.PI / 2;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var S = {};

  function smooth(t){ return t*t*(3-2*t); }
  function mkRnd(seed){ return function(){ seed = (seed*1103515245 + 12345) & 0x7fffffff; return seed/0x7fffffff; }; }
  function el(id){ return document.getElementById(id); }

  function quad(x0,y0,cx,cy,x1,y1,n){
    var p = [];
    for(var i=0;i<=n;i++){ var t=i/n, u=1-t;
      p.push([u*u*x0 + 2*u*t*cx + t*t*x1, u*u*y0 + 2*u*t*cy + t*t*y1]); }
    return p;
  }
  function ribbon(pts, wFn){
    var n = pts.length, L = [], R = [], i;
    for(i=0;i<n;i++){
      var a = pts[Math.max(0,i-1)], b = pts[Math.min(n-1,i+1)];
      var dx=b[0]-a[0], dy=b[1]-a[1], ln=Math.hypot(dx,dy)||1; dx/=ln; dy/=ln;
      var nx=-dy, ny=dx, w=wFn(i/(n-1));
      L.push([pts[i][0]+nx*w, pts[i][1]+ny*w]);
      R.push([pts[i][0]-nx*w, pts[i][1]-ny*w]);
    }
    var d = 'M'+L[0][0].toFixed(1)+' '+L[0][1].toFixed(1);
    for(i=1;i<n;i++) d += 'L'+L[i][0].toFixed(1)+' '+L[i][1].toFixed(1);
    for(i=n-1;i>=0;i--) d += 'L'+R[i][0].toFixed(1)+' '+R[i][1].toFixed(1);
    return d+'Z';
  }
  function poly(pts){
    var d='M'+pts[0][0].toFixed(1)+' '+pts[0][1].toFixed(1);
    for(var i=1;i<pts.length;i++) d+='L'+pts[i][0].toFixed(1)+' '+pts[i][1].toFixed(1);
    return d;
  }
  function reflectPath(d, ox){
    var k=0;
    return d.replace(/-?\d+\.?\d*/g, function(m){ return ((k++%2)===0) ? (2*ox-parseFloat(m)).toFixed(1) : m; });
  }

  function buildTree(){
    var svg = el('tp-tree-svg'), page = el('tp-page'), final = el('convite');
    if(!svg || !page) return;
    var W = Math.max(200, svg.getBoundingClientRect().width);
    var H = page.offsetHeight;
    svg.setAttribute('viewBox', '0 0 '+W+' '+H);

    var trunkBottom = H*0.9, finalH = final ? final.offsetHeight : H*0.4;
    var svgTop = svg.getBoundingClientRect().top;
    S.useImageRoots = false;
    var rimg = el('tp-roots-img'), cimg = el('tp-couple');
    if(rimg && rimg.getBoundingClientRect().height > 10){
      var rr = rimg.getBoundingClientRect();
      var rTop = rr.top - svgTop;
      trunkBottom = rTop + rr.height*0.055;
      S.useImageRoots = true;
      if(cimg && cimg.getBoundingClientRect().height > 10){
        var cr0 = cimg.getBoundingClientRect();
        S.boyStop = (cr0.top - svgTop) + cr0.height*0.46;
      } else { S.boyStop = rTop; }
    } else if(cimg && cimg.getBoundingClientRect().height > 10){
      var cr = cimg.getBoundingClientRect();
      var cTop = cr.top - svgTop, cH = cr.height;
      trunkBottom = cTop + cH*0.99;
      S.boyStop = cTop + cH*0.46;
    } else if(final){
      trunkBottom = final.offsetTop + finalH*0.70;
      S.boyStop = trunkBottom;
    }
    S.trunkBottom = trunkBottom;

    var grad = el('tp-gold'), gradB = el('tp-gold-bright');
    if(grad){ grad.setAttribute('y2', trunkBottom.toFixed(0)); }
    if(gradB){ gradB.setAttribute('y2', trunkBottom.toFixed(0)); }

    var x0 = W*0.87, xEnd = W*0.5, amp = W*0.02, diveStart = 0.70, diveEnd = 0.88;
    function centerX(t){
      var dive = t<=diveStart ? 0 : t>=diveEnd ? 1 : smooth((t-diveStart)/(diveEnd-diveStart));
      var base = x0 + (xEnd-x0)*dive;
      return base + amp*Math.sin(t*Math.PI*3.2)*Math.sin(t*Math.PI)*(1-dive);
    }
    var maxHW = Math.min(19, W*0.021);
    function halfW(t){
      var base = 1.1 + (maxHW-1.1)*Math.pow(t,1.3);
      var nf = t>0.82 ? 1 - ((t-0.82)/0.18)*0.42 : 1;
      return base*nf;
    }
    S.centerX = centerX; S.maxHW = maxHW;

    var N = 170, pts = [], i, t;
    for(i=0;i<=N;i++){ t=i/N; pts.push([centerX(t), t*trunkBottom]); }

    var ribbon0 = el('tp-trunk-ribbon');
    if(ribbon0) ribbon0.setAttribute('d', ribbon(pts, function(tt){ return halfW(tt); }));

    var edge = el('tp-trunk-edge');
    if(edge){
      var ep=[];
      for(i=0;i<=N;i+=2){ t=i/N;
        var a=pts[Math.max(0,i-1)], b=pts[Math.min(N,i+1)];
        var dx=b[0]-a[0], dy=b[1]-a[1], ln=Math.hypot(dx,dy)||1; var nx=-dy/ln, ny=dx/ln;
        var w=halfW(t)*0.82;
        ep.push([pts[i][0]+nx*w, pts[i][1]+ny*w]);
      }
      edge.setAttribute('d', poly(ep));
      edge.setAttribute('stroke-width', Math.max(0.8, maxHW*0.09).toFixed(2));
    }

    function strandRibbon(offFn, wFn){
      var cl=[];
      for(var ii=0;ii<=N;ii+=2){ var tt=ii/N;
        var a=pts[Math.max(0,ii-1)], b=pts[Math.min(N,ii+1)];
        var dx=b[0]-a[0], dy=b[1]-a[1], ln=Math.hypot(dx,dy)||1;
        var nx=-dy/ln, ny=dx/ln, off=offFn(tt);
        cl.push([pts[ii][0]+nx*off, pts[ii][1]+ny*off]);
      }
      return ribbon(cl, wFn);
    }
    var braidG = el('tp-fibers');
    if(braidG){
      braidG.setAttribute('fill','url(#tp-gold-bright)');
      braidG.setAttribute('stroke','none');
      var freq = 19, out = '', beadsOut = '';
      for(var s=0;s<2;s++){
        var ph = s*Math.PI;
        var offFn = (function(p){ return function(tt){
          var A = 2.2 + halfW(tt)*1.05;
          var conv = Math.min(1, tt/0.05);
          return Math.sin(tt*Math.PI*freq + p)*A*conv;
        }; })(ph);
        var wFn = function(u){
          var w = 0.9 + halfW(u)*0.22;
          var top = 0.3 + 0.7*Math.sin(Math.min(1,u/0.05)*HALF);
          var tip = u>0.9 ? (1-(u-0.9)/0.1*0.55) : 1;
          return w*top*tip;
        };
        out += '<path fill="'+(s?'url(#tp-gold-bright)':'url(#tp-gold)')+'" d="'+strandRibbon(offFn,wFn)+'" opacity="'+(s?0.5:0.42)+'"/>';
      }
      for(var c=1;c<freq;c++){
        var tc = c/freq; if(tc<0.06 || tc>0.92) continue;
        var xc = centerX(tc), yc = tc*trunkBottom, rc = 1.1 + halfW(tc)*0.15;
        beadsOut += '<circle fill="url(#tp-gold)" cx="'+xc.toFixed(1)+'" cy="'+yc.toFixed(1)+'" r="'+rc.toFixed(2)+'" opacity="0.5"/>';
      }
      braidG.innerHTML = out + beadsOut;
    }

    var vein = el('tp-vein');
    if(vein){
      var t0=0.30, vp=[];
      for(i=0;i<=70;i++){ t=t0+(1-t0)*(i/70); vp.push([centerX(t), t*trunkBottom]); }
      vein.setAttribute('d', poly(vp));
      vein.setAttribute('stroke-width', (maxHW*0.30).toFixed(2));
    }

    var tendG = el('tp-tendrils');
    if(tendG){
      var tr = mkRnd(4021), tspots = [0.40,0.50,0.60,0.70,0.78], tout='';
      for(var k=0;k<tspots.length;k++){
        var tt2 = tspots[k], side = (k%2===0)? 1 : -1;
        var bx = centerX(tt2), by = tt2*trunkBottom, hw2 = halfW(tt2);
        var len = hw2*2.4 + W*0.028*(0.7+tr());
        var ang = side>0 ? -0.30 : Math.PI+0.30;
        var ex = bx + Math.cos(ang)*len, ey = by + Math.sin(ang)*len - len*0.25;
        var cx = bx + Math.cos(ang)*len*0.5 + side*len*0.10, cy = by - len*0.05;
        var tp = quad(bx,by,cx,cy,ex,ey,14);
        tout += '<path d="'+ribbon(tp, function(u){ return (hw2*0.5)*(1-u) + 0.4; })+'"/>';
        tout += '<circle cx="'+ex.toFixed(1)+'" cy="'+ey.toFixed(1)+'" r="'+(1.4+tr()*1.4).toFixed(2)+'" fill="#E7C57F"/>';
      }
      tendG.innerHTML = tout;
    }

    var beads = el('tp-beads');
    if(beads){
      var br = mkRnd(20240), bc='', count=22;
      for(i=0;i<count;i++){
        var bt = 0.05 + (i/count)*0.64 + (br()-0.5)*0.03;
        var bside = br()<0.5 ? -1 : 1;
        var boff = halfW(bt) + 6 + br()*(W*0.05);
        var bxx = centerX(bt) + bside*boff;
        var byy = bt*trunkBottom + (br()-0.5)*(H*0.008);
        var brad = 1.1 + br()*2.4;
        bc += '<circle cx="'+bxx.toFixed(1)+'" cy="'+byy.toFixed(1)+'" r="'+brad.toFixed(2)+'" opacity="'+(0.22+br()*0.3).toFixed(2)+'"/>';
      }
      beads.innerHTML = bc;
    }

    var halo = el('tp-bloom-halo');
    if(halo){
      halo.setAttribute('cx', centerX(1).toFixed(1));
      halo.setAttribute('cy', trunkBottom.toFixed(1));
      halo.setAttribute('r', Math.min(W*0.13, 130).toFixed(0));
    }

    if(S.useImageRoots){
      ['tp-roots','tp-root-veins','tp-rootnodes'].forEach(function(id){ var g=el(id); if(g) g.innerHTML=''; });
    } else {
      var avail = Math.max(120, H - trunkBottom);
      var baseLen = Math.min(W*0.22, avail*0.82);
      buildRoots(centerX(1), trunkBottom, baseLen);
    }

    var sm = el('tp-sunmoon');
    if(sm) sm.style.left = ((x0/W)*100).toFixed(2)+'%';

    var rect = el('tp-tree-clip-rect');
    if(rect) rect.setAttribute('width', String(W+10));
  }

  function buildRoots(ox, oy, baseLen){
    var rootsG = el('tp-roots'), veinsG = el('tp-root-veins'), nodesG = el('tp-rootnodes');
    if(!rootsG) return;
    var w0 = S.maxHW ? S.maxHW*1.05 : 14;

    function growSide(seed){
      var rnd = mkRnd(seed);
      var fills = [], veins = [], dots = [];
      function grow(x, y, ang, len, w, depth){
        if(depth<=0 || len<9 || w<0.5) return;
        var ex = x + Math.cos(ang)*len, ey = y + Math.sin(ang)*len;
        var nx = Math.cos(ang+HALF), ny = Math.sin(ang+HALF);
        var bend = len*0.20*(rnd()-0.5);
        var cx = x + Math.cos(ang)*len*0.5 + nx*bend;
        var cy = y + Math.sin(ang)*len*0.5 + ny*bend;
        var pts = quad(x,y,cx,cy,ex,ey,18);
        var w1 = w*0.44;
        fills.push('<path d="'+ribbon(pts, function(u){ return (w + (w1-w)*u)/2; })+'"/>');
        veins.push('<path d="'+poly(pts)+'" stroke-width="'+(w*0.16+0.35).toFixed(2)+'"/>');
        if(depth<=2 || rnd()<0.4)
          dots.push('<circle cx="'+ex.toFixed(1)+'" cy="'+ey.toFixed(1)+'" r="'+Math.max(1.1, w1*0.95).toFixed(2)+'"/>');
        var n = depth>2 ? 3 : 2;
        for(var i=0;i<n;i++){
          var na = ang + (i-(n-1)/2)*(0.36+rnd()*0.30) + (rnd()-0.5)*0.18;
          na = Math.max(HALF-1.24, Math.min(HALF+1.24, na));
          grow(ex, ey, na, len*(0.62+rnd()*0.16), w1*(0.94+rnd()*0.16), depth-1);
        }
      }
      var primaries = [
        [HALF-0.22, baseLen*1.00, w0*0.94],
        [HALF-0.48, baseLen*0.92, w0*0.82],
        [HALF-0.76, baseLen*0.82, w0*0.68],
        [HALF-1.04, baseLen*0.70, w0*0.54],
        [HALF-1.26, baseLen*0.56, w0*0.44]
      ];
      for(var p=0;p<primaries.length;p++)
        grow(ox, oy, primaries[p][0], primaries[p][1], primaries[p][2], 5);
      return { fills:fills, veins:veins, dots:dots };
    }

    var center = (function(){
      var rnd = mkRnd(777);
      var fills=[], veins=[], dots=[];
      (function grow(x,y,ang,len,w,depth){
        if(depth<=0||len<9||w<0.5) return;
        var ex=x+Math.cos(ang)*len, ey=y+Math.sin(ang)*len;
        var bend=len*0.10*(rnd()-0.5);
        var cx=x+Math.cos(ang)*len*0.5+bend, cy=y+Math.sin(ang)*len*0.5;
        var pts=quad(x,y,cx,cy,ex,ey,18);
        var w1=w*0.46;
        fills.push('<path d="'+ribbon(pts,function(u){return (w+(w1-w)*u)/2;})+'"/>');
        veins.push('<path d="'+poly(pts)+'" stroke-width="'+(w*0.16+0.35).toFixed(2)+'"/>');
        if(depth<=2) dots.push('<circle cx="'+ex.toFixed(1)+'" cy="'+ey.toFixed(1)+'" r="'+Math.max(1.1,w1*0.95).toFixed(2)+'"/>');
        var n=depth>2?2:2;
        for(var i=0;i<n;i++){
          var na=ang+(i-(n-1)/2)*(0.30+rnd()*0.22)+(rnd()-0.5)*0.14;
          na=Math.max(HALF-0.9,Math.min(HALF+0.9,na));
          grow(ex,ey,na,len*(0.62+rnd()*0.14),w1*(0.96+rnd()*0.12),depth-1);
        }
      })(ox,oy,HALF,baseLen*1.02,w0,5);
      return {fills:fills,veins:veins,dots:dots};
    })();

    var right = growSide(8123);

    var fills = center.fills.concat(right.fills);
    var veins = center.veins.concat(right.veins);
    var dots  = center.dots.concat(right.dots);
    for(var i=0;i<right.fills.length;i++) fills.push(reflectPath(right.fills[i], ox));
    for(i=0;i<right.veins.length;i++)     veins.push(reflectPath(right.veins[i], ox));
    for(i=0;i<right.dots.length;i++){
      dots.push(right.dots[i].replace(/cx="(-?\d+\.?\d*)"/, function(_,v){ return 'cx="'+(2*ox-parseFloat(v)).toFixed(1)+'"'; }));
    }

    rootsG.innerHTML = fills.join('');
    if(veinsG) veinsG.innerHTML = veins.join('');
    if(nodesG) nodesG.innerHTML = dots.join('');
  }

  function setReveal(){
    var clamp = function(v){ return Math.max(0, Math.min(1, v)); };
    var clip = el('tp-tree-clip-rect'), boy = el('tp-boy'), svg = el('tp-tree-svg'), page = el('tp-page');
    var tb = S.trunkBottom || (page ? page.offsetHeight*0.9 : 1000);
    var cX = S.centerX || function(){ return 0; };

    if(reduce){
      if(clip) clip.setAttribute('height', String((page?page.offsetHeight:9999)+200));
      if(boy){ var sp=S.boyStop||tb; boy.style.left=cX(clamp(sp/tb)).toFixed(1)+'px'; boy.style.top=sp.toFixed(1)+'px'; boy.style.opacity='0.9'; }
      return;
    }
    var svgTop = svg ? svg.getBoundingClientRect().top : -window.scrollY;
    var revealY = (-svgTop) + window.innerHeight*0.9;
    if(clip) clip.setAttribute('height', Math.max(0, revealY).toFixed(0));
    if(boy){
      var stop = S.boyStop || tb;
      var tipY = Math.min(Math.max(0, revealY - window.innerHeight*0.12), stop);
      var tt = clamp(tb>0 ? tipY/tb : 0);
      boy.style.left = cX(tt).toFixed(1)+'px';
      boy.style.top = tipY.toFixed(1)+'px';
      boy.style.opacity = clamp(tipY/240).toFixed(2);
    }
  }

  function setupReveal(){
    var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
    if(reduce){ els.forEach(function(e){ e.style.opacity='1'; e.style.transform='none'; }); return; }
    els.forEach(function(e){ e.style.opacity='0'; e.style.transform='translateY(26px)'; e.style.transition='opacity 1s ease, transform 1s ease'; });
    var io = new IntersectionObserver(function(ents){
      ents.forEach(function(e){ if(e.isIntersecting){ e.target.style.opacity='1'; e.target.style.transform='none'; io.unobserve(e.target); } });
    }, { threshold:0.12 });
    els.forEach(function(e){ io.observe(e); });
  }

  function init(){
    buildTree(); setReveal(); setupReveal();
    setTimeout(function(){ buildTree(); setReveal(); }, 400);
    setTimeout(function(){ buildTree(); setReveal(); }, 1200);
    window.addEventListener('load', function(){ buildTree(); setReveal(); });

    if(!reduce){
      var rt;
      window.addEventListener('resize', function(){ clearTimeout(rt); rt=setTimeout(function(){ buildTree(); setReveal(); }, 150); });
      window.addEventListener('scroll', setReveal, { passive:true, capture:true });
      var lastTop = null;
      (function tick(){
        var svg = el('tp-tree-svg');
        var top = svg ? Math.round(svg.getBoundingClientRect().top) : 0;
        if(top !== lastTop){ lastTop = top; setReveal(); }
        requestAnimationFrame(tick);
      })();
    }
  }

  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

<!-- MÚSICA DE FUNDO -->
<script is:inline>
(function(){
  "use strict";
  var audio = document.getElementById('tp-audio');
  var btn = document.getElementById('tp-som');
  if(!audio || !btn) return;
  if(!audio.getAttribute('src')){ return; }

  var ON  = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';
  var OFF = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/><line x1="3" y1="3" x2="21" y2="21" stroke-width="2"/></svg>';

  var userMuted = false;
  var started   = false;
  var wasPlaying = false;

  function paint(){
    var on = !audio.paused;
    btn.innerHTML = on ? ON : OFF;
    btn.style.opacity = on ? '1' : '0.62';
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    var label = on ? 'Desligar música' : 'Ligar música';
    btn.setAttribute('aria-label', label); btn.title = label;
  }
  function tryPlay(){ return audio.play().then(paint).catch(paint); }

  audio.addEventListener('canplaythrough', function(){ btn.style.display = 'flex'; paint(); });
  audio.addEventListener('loadeddata',    function(){ btn.style.display = 'flex'; paint(); });
  audio.addEventListener('error',         function(){ btn.style.display = 'none'; });

  tryPlay();
  function firstGesture(){
    if(started) return; started = true;
    if(!userMuted && audio.paused) tryPlay();
    remove();
  }
  function remove(){
    ['pointerdown','keydown','touchstart','scroll'].forEach(function(ev){
      window.removeEventListener(ev, firstGesture, true);
    });
  }
  ['pointerdown','keydown','touchstart','scroll'].forEach(function(ev){
    window.addEventListener(ev, firstGesture, { capture:true, passive:true });
  });

  btn.addEventListener('click', function(e){
    e.stopPropagation();
    if(audio.paused){ userMuted = false; tryPlay(); }
    else { userMuted = true; audio.pause(); paint(); }
  });

  document.addEventListener('play', function(e){
    if(e.target && e.target.tagName === 'VIDEO'){
      wasPlaying = !audio.paused;
      if(wasPlaying){ audio.pause(); paint(); }
    }
  }, true);
  function videoStopped(e){
    if(e.target && e.target.tagName === 'VIDEO'){
      if(wasPlaying && !userMuted){ tryPlay(); }
      wasPlaying = false;
    }
  }
  document.addEventListener('pause', videoStopped, true);
  document.addEventListener('ended', videoStopped, true);

  paint();
})();
</script>

<!-- POP-UP: abre 1x por sessão, com fechar (X), clique fora e Esc -->
<script is:inline>
(function(){
  "use strict";
  var overlay = document.getElementById('tp-popup-overlay');
  if(!overlay) return;
  var card = document.getElementById('tp-popup');
  var KEY = 'tp-popup-seen';
  try { if(sessionStorage.getItem(KEY)) return; } catch(e){}
  function open(){
    overlay.style.display = 'flex';
    requestAnimationFrame(function(){ if(card){ card.style.opacity='1'; card.style.transform='none'; } });
  }
  function close(){
    if(card){ card.style.opacity='0'; card.style.transform='translateY(12px) scale(0.98)'; }
    setTimeout(function(){ overlay.style.display='none'; }, 350);
    try { sessionStorage.setItem(KEY,'1'); } catch(e){}
  }
  var btn = document.getElementById('tp-popup-close');
  if(btn) btn.addEventListener('click', close);
  overlay.addEventListener('click', function(e){ if(e.target === overlay) close(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') close(); });
  setTimeout(open, 900);
})();
</script>
</body>
</html>
