      <img id="tp-couple" src="/assets/casal.webp" alt="Ilustração de mãe e pai frente a frente: os vínculos familiares que nos formam na Visão Sistêmica" width="845" height="660" loading="lazy" decoding="async" style="display:block; width:min(560px,88vw); height:auto; margin:72px auto 0; opacity:0.97;">
      <img id="tp-roots-img" src="/assets/raizes.webp" alt="Árvore de raízes com retratos de várias gerações: os padrões familiares transgeracionais da constelação familiar" width="1536" height="844" loading="lazy" decoding="async" style="display:block; width:min(1080px,100%); height:auto; margin:10px auto 0; opacity:0.98;">
    </div>
