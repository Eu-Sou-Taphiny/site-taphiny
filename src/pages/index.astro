<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">

<!-- Fontes -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<link rel="preload" as="image" href="/assets/selo.webp">

<style is:global>
  :root{
    --creme:#F6F1EA; --rosa:#DCC4BB; --areia:#BFA79A; --marrom:#521416;
    --bordeaux:#6A3F4B; --terracota:#A56E5F; --ouro:#B7905B; --ouroc:#D9B67A;
    --marrom-escuro:#3A0D0F;
    /* tons de texto para fundo claro (AA): terracota 5,1:1 e ouro 5,3:1 no creme */
    --terracota-t:#8C5A4D; --ouro-t:#7E5E33;
  }
  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{ background:var(--marrom); -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; overflow-x:hidden; }
  img{ display:block; max-width:100%; }
  a{ color:var(--ouro); }
  a:hover{ color:var(--ouroc); }
  :focus-visible{ outline:2px solid var(--ouroc); outline-offset:3px; border-radius:2px; }
  ::selection{ background:var(--ouro); color:var(--creme); }
  @media (prefers-reduced-motion: reduce){ html{ scroll-behavior:auto; } }
  .tp-btn{ transition:opacity .4s; }
  .tp-btn:hover{ opacity:.85; }

  /* ---------- Citações e frases em destaque ----------
     Sem itálico: Playfair regular, entrelinha 1,5. Tamanho e cor ficam em cada
     uso, porque dependem do fundo. */
  /* seção que cai no rosa: terracota e ouro de texto um pouco mais escuros
     (4,8:1 e 4,9:1 no rosa; o creme já passava com os tons de :root) */
  .tp-fundo-rosa{ --terracota-t:#734538; --ouro-t:#654A26; }

  .tp-citacao{ font-family:'Playfair Display',serif; font-style:normal; font-weight:400;
               line-height:1.5; text-wrap:pretty; }

  /* ============================================================
     COMPONENTES EDITORIAIS (seções de texto mais visuais)
     Autoconsciência, Minha abordagem, Visão Sistêmica e Quem conduz.
     Cores de texto conferidas em AA sobre creme, rosa e bordeaux.
     ============================================================ */
  .tp-larga{ max-width:760px; margin:0 auto; }
  .tp-abertura{ font-family:'Montserrat',sans-serif; font-weight:300; font-size:17px; line-height:1.95;
                color:var(--marrom); text-align:center; max-width:580px; margin:0 auto; text-wrap:pretty; }
  .tp-rotulo-mini{ font-family:'Montserrat',sans-serif; font-size:11px; letter-spacing:0.28em;
                   text-transform:uppercase; color:var(--bordeaux); text-align:center; margin-bottom:22px; }
  .tp-subtit{ font-family:'Playfair Display',serif; font-weight:400; font-size:25px; line-height:1.3;
              color:var(--marrom); text-align:center; margin-bottom:34px; text-wrap:balance; }
  .tp-subtit::before{ content:''; display:block; width:36px; height:1px; background:var(--ouro);
                      margin:0 auto 22px; }

  /* contraste em duas colunas: a de cá (fraca) e a de lá (forte) */
  .tp-contraste{ display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); gap:18px; }
  .tp-contraste-col{ padding:34px 30px; }
  .tp-contraste-col.fraca{ background:#FBF8F3; border:1px solid var(--areia); color:var(--marrom); }
  .tp-contraste-col.forte{ background:var(--bordeaux); color:var(--creme); }
  .tp-contraste-tit{ font-family:'Playfair Display',serif; font-weight:500; font-size:22px; line-height:1.3;
                     margin-bottom:16px; padding-bottom:16px; border-bottom:1px solid var(--areia); }
  .tp-contraste-col.forte .tp-contraste-tit{ border-bottom-color:rgba(217,182,122,0.55); }
  .tp-contraste-col p, .tp-contraste-col li{ font-family:'Montserrat',sans-serif; font-weight:300;
                     font-size:15px; line-height:1.85; text-wrap:pretty; }
  .tp-contraste-col.forte p, .tp-contraste-col.forte li{ font-weight:400; }
  .tp-contraste-col ul{ list-style:none; display:flex; flex-direction:column; gap:12px; }
  .tp-contraste-col li{ position:relative; padding-left:20px; }
  .tp-contraste-col li::before{ content:''; position:absolute; left:0; top:0.85em; width:9px; height:1px;
                     background:currentColor; opacity:0.7; }

  /* cartões numerados */
  .tp-num-cards{ list-style:none; display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:18px; }
  .tp-num-card{ background:#FBF8F3; border-top:2px solid var(--ouro); padding:30px 26px 32px; }
  .tp-num{ display:block; font-family:'Playfair Display',serif; font-size:40px; line-height:1;
           color:var(--ouro-t); margin-bottom:18px; }
  .tp-num-card h4{ font-family:'Playfair Display',serif; font-weight:500; font-size:20px; line-height:1.3;
                   color:var(--marrom); margin-bottom:12px; text-wrap:balance; }
  .tp-num-card p{ font-family:'Montserrat',sans-serif; font-weight:300; font-size:14.5px; line-height:1.85;
                  color:var(--bordeaux); text-wrap:pretty; }

  /* bloco em destaque (fio de ouro à esquerda) */
  .tp-destaque{ border-left:3px solid var(--ouro); padding:8px 0 8px 28px; font-size:21px; color:var(--marrom);
                max-width:620px; margin:0 auto; }
  .tp-destaque.escuro{ border-left-color:var(--ouroc); color:var(--creme); }

  /* frase de fechamento (e a frase grande da Visão Sistêmica) */
  .tp-fecho{ font-size:24px; color:var(--marrom); text-align:center; max-width:560px; margin:0 auto; }
  .tp-fecho.grande{ font-size:clamp(26px, 5vw, 34px); line-height:1.35; max-width:640px; text-wrap:balance; }
  .tp-fecho::before{ content:''; display:block; width:36px; height:1px; background:var(--ouro); margin:0 auto 26px; }

  /* chips */
  .tp-chips{ list-style:none; display:flex; flex-wrap:wrap; justify-content:center; gap:10px; max-width:560px; margin:0 auto; }
  .tp-chips li{ font-family:'Montserrat',sans-serif; font-size:12px; letter-spacing:0.14em; text-transform:uppercase;
                color:var(--marrom); background:var(--creme); border:1px solid var(--ouro); border-radius:999px;
                padding:11px 20px; }

  /* linha do tempo: vertical no celular, horizontal a partir de 720px */
  .tp-etapas{ list-style:none; display:flex; flex-direction:column; }
  .tp-etapas li{ position:relative; display:grid; grid-template-columns:44px 1fr; column-gap:20px; padding-bottom:30px; }
  .tp-etapas li:last-child{ padding-bottom:0; }
  .tp-etapas li:not(:last-child)::after{ content:''; position:absolute; left:21.5px; top:44px; bottom:0;
                width:1px; background:var(--ouro); opacity:0.6; }
  .tp-etapa-bola{ grid-row:span 2; display:grid; place-items:center; width:44px; height:44px; border-radius:50%;
                  border:1px solid var(--ouro); background:var(--creme); font-family:'Playfair Display',serif;
                  font-size:18px; color:var(--marrom); }
  .tp-etapas h4{ font-family:'Playfair Display',serif; font-weight:500; font-size:20px; line-height:1.3;
                 color:var(--marrom); padding-top:9px; margin-bottom:6px; }
  .tp-etapas p{ font-family:'Montserrat',sans-serif; font-weight:300; font-size:15px; line-height:1.8;
                color:var(--bordeaux); text-wrap:pretty; }
  @media (min-width:720px){
    .tp-etapas{ display:grid; grid-template-columns:repeat(var(--n, 3), 1fr); column-gap:28px; }
    .tp-etapas li{ display:block; text-align:center; padding-bottom:0; }
    .tp-etapas li:not(:last-child)::after{ left:calc(50% + 34px); right:calc(-50% + 6px); top:22px; bottom:auto; width:auto; height:1px; }
    .tp-etapa-bola{ margin:0 auto 18px; }
    .tp-etapas h4{ padding-top:0; }
  }

  /* trajetória (Quem conduz, fundo bordeaux) */
  .tp-traj{ list-style:none; position:relative; padding-left:34px; }
  .tp-traj li{ position:relative; font-family:'Montserrat',sans-serif; font-weight:300; font-size:15.5px;
               line-height:1.85; color:var(--rosa); padding-bottom:22px; text-wrap:pretty; }
  .tp-traj li:last-child{ padding-bottom:0; color:var(--creme); font-weight:400; }
  .tp-traj li::before{ content:''; position:absolute; left:-34px; top:0.55em; width:11px; height:11px;
                       border-radius:50%; border:1px solid var(--ouroc); background:var(--bordeaux); }
  .tp-traj li:last-child::before{ background:var(--ouroc); }
  /* fio de um ponto ao seguinte (termina no último, não passa dele) */
  .tp-traj li:not(:last-child)::after{ content:''; position:absolute; left:-29px; top:calc(0.55em + 11px);
                       bottom:-0.55em; width:1px; background:rgba(217,182,122,0.75); }

  /* espaço entre blocos: vem por último para vencer o `margin:0 auto` dos blocos centralizados */
  .tp-espaco{ margin-top:72px; }

  @media (max-width:480px){
    .tp-abertura{ font-size:16px; }
    .tp-contraste-col{ padding:28px 24px; }
    .tp-destaque{ font-size:19px; padding-left:22px; }
    .tp-fecho{ font-size:21px; }
    .tp-espaco{ margin-top:56px; }
  }

  /* ---------- FAQ em sanfona (clique para expandir) ---------- */
  .tp-faq-item{ border-bottom:1px solid var(--areia); }
  .tp-faq-item:first-child{ border-top:1px solid var(--areia); }
  .tp-faq-q{ display:flex; align-items:flex-start; justify-content:space-between; gap:22px;
             padding:26px 0; cursor:pointer; list-style:none; }
  .tp-faq-q::-webkit-details-marker{ display:none; }
  .tp-faq-q h3{ font-family:'Playfair Display',serif; font-weight:400; font-size:21px; line-height:1.35;
                color:var(--marrom); text-wrap:pretty; transition:color .3s; }
  .tp-faq-q:hover h3{ color:var(--terracota-t); }
  .tp-faq-i{ flex:none; width:22px; height:22px; margin-top:4px; position:relative;
             transition:transform .35s ease; }
  .tp-faq-i::before, .tp-faq-i::after{ content:''; position:absolute; top:50%; left:50%; background:var(--ouro);
             transform:translate(-50%,-50%); }
  .tp-faq-i::before{ width:15px; height:1px; }
  .tp-faq-i::after{ width:1px; height:15px; }
  .tp-faq-item[open] .tp-faq-i{ transform:rotate(135deg); }
  .tp-faq-a{ font-family:'Montserrat',sans-serif; font-weight:300; font-size:15px; line-height:1.95;
             color:var(--bordeaux); padding:0 42px 30px 0; text-wrap:pretty; }
  .tp-faq-item[open] .tp-faq-a{ animation:tp-faq-abrir .32s ease both; }
  @keyframes tp-faq-abrir{ from{ opacity:0; transform:translateY(-6px); } to{ opacity:1; transform:none; } }
  @media (prefers-reduced-motion: reduce){
    .tp-faq-i{ transition:none; }
    .tp-faq-item[open] .tp-faq-a{ animation:none; }
  }
  @media (max-width:480px){
    .tp-faq-q{ gap:16px; padding:22px 0; }
    .tp-faq-q h3{ font-size:19px; }
    .tp-faq-a{ padding-right:0; }
  }

  /* ---------- Seções fechadas (modo blocado, ligado no painel) ---------- */
  .tp-bloco-cab{ display:flex; align-items:flex-start; justify-content:space-between; gap:26px;
                 cursor:pointer; list-style:none; }
  .tp-bloco-cab::-webkit-details-marker{ display:none; }
  .tp-bloco-cab-txt{ flex:1 1 auto; min-width:0; }
  /* seção de título centralizado: espaçador do mesmo tamanho do "+" à esquerda,
     senão o texto fica 26px fora do eixo da página */
  .tp-centro .tp-bloco-cab::before{ content:''; flex:none; width:26px; }
  @media (max-width:480px){ .tp-centro .tp-bloco-cab::before{ width:22px; } }
  /* o título já traz a margem da seção; dentro do cabeçalho ela sobra */
  .tp-bloco-cab-txt > *{ margin-bottom:0 !important; }
  .tp-bloco-cab-txt > *:not(:last-child){ margin-bottom:14px !important; }
  .tp-bloco-i{ flex:none; width:26px; height:26px; margin-top:6px; position:relative;
               color:var(--ouro); transition:transform .35s ease; }
  .tp-bloco-i::before, .tp-bloco-i::after{ content:''; position:absolute; top:50%; left:50%;
               background:currentColor; transform:translate(-50%,-50%); }
  .tp-bloco-i::before{ width:20px; height:1.5px; }
  .tp-bloco-i::after{ width:1.5px; height:20px; }
  .tp-bloco[open] .tp-bloco-i{ transform:rotate(135deg); }
  .tp-bloco-corpo{ padding-top:34px; }
  .tp-bloco[open] .tp-bloco-corpo{ animation:tp-bloco-abrir .42s ease both; }
  @keyframes tp-bloco-abrir{ from{ opacity:0; transform:translateY(-10px); } to{ opacity:1; transform:none; } }
  @media (prefers-reduced-motion: reduce){
    .tp-bloco-i{ transition:none; }
    .tp-bloco[open] .tp-bloco-corpo{ animation:none; }
  }
  @media (max-width:480px){
    .tp-bloco-cab{ gap:16px; }
    .tp-bloco-i{ width:22px; height:22px; }
    .tp-bloco-i::before{ width:17px; } .tp-bloco-i::after{ height:17px; }
  }

  /* ============================================================
     INTERATIVOS (item 4). Regra que vale para os três primeiros:
     sem JavaScript, o bloco continua sendo o formato de hoje. O
     script marca o pai com a classe `js` e só então o modo
     interativo entra em cena.
     ============================================================ */

  /* ---------- 4b) Comparativo como chave ---------- */
  .tp-vs-chave{ display:none; }
  .tp-vs-palco{ display:flex; flex-wrap:wrap; gap:28px; }
  .tp-vs-col{ flex:1 1 240px; padding:40px 30px; background:#FBF8F3; }
  .tp-vs-destaque{ border:1px solid var(--ouro); }
  .tp-vs-tit{ font-family:'Playfair Display',serif; font-size:21px; color:var(--marrom);
              margin-bottom:24px; padding-bottom:16px; border-bottom:1px solid var(--areia); }
  .tp-vs-destaque .tp-vs-tit{ border-bottom-color:var(--ouro); }
  .tp-vs-lista{ list-style:none; display:flex; flex-direction:column; gap:16px; }
  .tp-vs-lista li{ font-family:'Montserrat',sans-serif; font-weight:300; font-size:14px;
                   line-height:1.75; color:var(--marrom); }

  .tp-vs.js .tp-vs-chave{ display:flex; position:relative; margin:0 auto 34px; max-width:440px;
                          border:1px solid var(--areia); background:#FBF8F3; padding:4px; }
  .tp-vs.js .tp-vs-bt{ flex:1 1 0; position:relative; z-index:1; border:none; background:none;
                       cursor:pointer; padding:14px 10px; font-family:'Montserrat',sans-serif;
                       font-size:11px; letter-spacing:0.14em; text-transform:uppercase;
                       transition:color .35s ease, background .35s ease; }
  /* selecionado: bordô sólido e texto creme (7,7:1); o outro fica claro, com
     texto marrom (13:1), e ganha só um véu de bordô ao passar o mouse */
  .tp-vs.js .tp-vs-bt{ color:var(--marrom); }
  .tp-vs.js .tp-vs-bt:not(.ativo):hover{ background:rgba(106,63,75,0.08); }
  .tp-vs.js .tp-vs-bt.ativo{ color:var(--creme); font-weight:500; }
  .tp-vs.js .tp-vs-marca{ position:absolute; z-index:0; top:4px; bottom:4px; left:4px;
                          width:calc(50% - 4px); background:var(--bordeaux);
                          transition:transform .38s cubic-bezier(.4,0,.2,1); }
  .tp-vs.js .tp-vs-chave[data-em="2"] .tp-vs-marca{ transform:translateX(100%); }
  .tp-vs.js .tp-vs-col{ display:none; }
  .tp-vs.js .tp-vs-col.ativo{ display:block; flex:1 1 100%;
                              animation:tp-troca .4s ease both; }
  @keyframes tp-troca{ from{ opacity:0; transform:translateY(10px); } to{ opacity:1; transform:none; } }

  /* ---------- Pilares: três cartões de cor sólida, todos à vista ---------- */
  /* Cores com contraste AA medido: terracota escurecida #95604F com creme
     (4,6:1), ouro velho com marrom (4,9:1), bordeaux com creme (7,7:1). Um
     quarto pilar, se ela criar, recomeça o ciclo de cores. */
  .tp-pil-cards{ display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:16px; }
  .tp-pil-card{ padding:32px 22px 30px; text-align:center; }
  @media (max-width:480px){ .tp-pil-card{ padding:24px 20px 22px; } .tp-pil-icone{ width:38px; height:38px; margin-bottom:12px; } }
  .tp-pil-card.cor-0{ background:#95604F; color:var(--creme); }
  .tp-pil-card.cor-1{ background:var(--ouro); color:var(--marrom); }
  .tp-pil-card.cor-2{ background:var(--bordeaux); color:var(--creme); }
  .tp-pil-icone{ display:block; width:46px; height:46px; margin:0 auto 18px; }
  .tp-pil-tit{ font-family:'Playfair Display',serif; font-weight:600; font-size:22px; line-height:1.25;
               margin-bottom:12px; }
  .tp-pil-card p{ font-family:'Montserrat',sans-serif; font-weight:400; font-size:14.5px; line-height:1.7;
                  text-wrap:pretty; }

  /* ---------- 4d) Esteira como trilha ---------- */
  .tp-trilha{ display:none; }
  .tp-trilha.js{ display:flex; position:relative; justify-content:space-between;
                 margin:0 4px 40px; }
  .tp-trilha-linha{ position:absolute; top:19px; left:8%; right:8%; height:1px;
                    background:linear-gradient(90deg, transparent, var(--areia) 12%, var(--areia) 88%, transparent); }
  .tp-trilha-no{ position:relative; z-index:1; flex:1 1 0; display:flex; flex-direction:column;
                 align-items:center; gap:12px; border:none; background:none; cursor:pointer;
                 padding:0; }
  .tp-trilha-bola{ display:grid; place-items:center; width:38px; height:38px; border-radius:50%;
                   border:1px solid var(--areia); background:var(--creme);
                   font-family:'Playfair Display',serif; font-style:italic; font-size:15px;
                   color:var(--ouro-t); transition:border-color .35s ease, background .35s ease, color .35s ease; }
  .tp-trilha-no:hover .tp-trilha-bola{ border-color:var(--ouro); }
  .tp-trilha-no.ativo .tp-trilha-bola{ border-color:var(--ouro); background:var(--ouro); color:var(--marrom); }
  .tp-trilha-no.ativo .tp-trilha-nome{ color:var(--marrom); font-weight:500; }
  .tp-trilha-nome{ font-family:'Montserrat',sans-serif; font-size:10px; letter-spacing:0.14em;
                   text-transform:uppercase; color:var(--bordeaux); text-align:center;
                   line-height:1.5; max-width:11ch; }
  /* no fundo areia (Empresas) a linha e os nomes da trilha vão para o marrom */
  .tp-fundo-areia .tp-trilha-linha{ background:linear-gradient(90deg, transparent, rgba(82,20,22,0.35) 12%, rgba(82,20,22,0.35) 88%, transparent); }
  .tp-fundo-areia .tp-trilha-nome{ color:var(--marrom); }
  .tp-cards.js .tp-card{ display:none; }
  .tp-cards.js .tp-card.ativo{ display:block; animation:tp-troca .4s ease both; }

  /* ---------- 4a) Constelação interativa (seção própria) ---------- */
  /* Com vídeo: celular empilha (vídeo em cima), desktop põe lado a lado. O
     vídeo é outro elemento, então não disputa o toque com as bolinhas. */
  .tp-const-duo{ display:flex; flex-direction:column; gap:40px; margin-top:34px; }
  .tp-const-video{ margin:0 auto; width:100%; border:1px solid var(--ouro); overflow:hidden;
                   background:#3A0D0F; }
  .tp-const-video.tp-fmt-vertical{ max-width:320px; }
  .tp-const-video.tp-fmt-retrato{ max-width:420px; }
  @media (min-width:860px){
    .tp-const-duo{ flex-direction:row; align-items:center; gap:56px; }
    .tp-const-duo > *{ flex:1 1 0; min-width:0; }
    .tp-const-video.tp-fmt-vertical{ flex:0 1 320px; }
  }
  .tp-const-dica{ font-family:'Montserrat',sans-serif; font-weight:300; font-size:13px;
                  line-height:1.8; color:var(--bordeaux); text-align:center; max-width:390px;
                  margin:0 auto; text-wrap:pretty; }
  .tp-const-palco{ display:block; width:100%; height:auto; touch-action:none;
                   margin:22px auto 0; max-width:520px; }
  .tp-const-alvo{ fill:none; stroke:var(--areia); stroke-width:1; stroke-dasharray:3 5;
                  transition:stroke .4s ease, stroke-dasharray .4s ease; }
  .tp-const-alvo.ok{ stroke:var(--ouro); stroke-dasharray:none; }
  .tp-const-peca{ cursor:grab; }
  .tp-const-peca.pegando{ cursor:grabbing; }
  .tp-const-peca circle{ fill:#FBF3E6; stroke:var(--terracota); stroke-width:1.2;
                         transition:fill .35s ease, stroke .35s ease, r .45s ease; }
  .tp-const-peca.ok circle{ fill:var(--ouro); fill-opacity:0.28; stroke:var(--ouro); }
  /* sintoma e destino: sem lugar marcado, então vêm com traço interrompido —
     a pessoa vê que ali não há resposta certa esperando por ela */
  .tp-const-peca.livre circle{ stroke-dasharray:4 4; }
  .tp-const-peca.livre.ok circle{ stroke-dasharray:none; }
  .tp-const-peca text{ font-family:'Montserrat',sans-serif; font-size:9.5px; font-weight:400;
                       letter-spacing:0.08em; fill:var(--marrom); text-anchor:middle;
                       pointer-events:none; user-select:none; }
  /* rótulo de duas linhas (os ancestrais) cabe com a letra um pouco menor */
  .tp-const-peca text.duas{ font-size:8.6px; letter-spacing:0.04em; }
  .tp-const-fim{ font-family:'Playfair Display',serif; font-style:normal; font-size:20px;
                 line-height:1.5; color:var(--bordeaux); text-align:center; max-width:420px;
                 margin:6px auto 0; opacity:0; transform:translateY(8px);
                 transition:opacity .7s ease, transform .7s ease; }
  .tp-const.completo .tp-const-fim{ opacity:1; transform:none; }
  .tp-const-bts{ display:flex; justify-content:center; gap:12px; margin-top:26px; }
  .tp-const-bt{ border:1px solid var(--areia); background:none; cursor:pointer;
                padding:11px 20px; font-family:'Montserrat',sans-serif; font-size:10px;
                letter-spacing:0.2em; text-transform:uppercase; color:var(--bordeaux);
                transition:border-color .3s ease, color .3s ease; }
  .tp-const-bt:hover{ border-color:var(--ouro); color:var(--marrom); }

  @media (prefers-reduced-motion: reduce){
    .tp-vs.js .tp-vs-col.ativo, .tp-cards.js .tp-card.ativo{ animation:none; }
    .tp-vs.js .tp-vs-marca, .tp-vs.js .tp-vs-bt, .tp-const-fim, .tp-const-alvo, .tp-const-peca circle{ transition:none; }
  }
</style>

<!-- DADOS ESTRUTURADOS (schema.org / JSON-LD) -->
<script type="application/ld+json" is:inline set:html={jsonLdHtml(site)}></script>

<!-- Google Analytics 4 -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H58M107G7T"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-H58M107G7T');
</script>
</head>
<body>

<div id="tp-page" style="position:relative; font-family:'Montserrat',sans-serif; color:var(--marrom);">

  <!-- ÁRVORE ASSINATURA: sol/lua → tronco de ouro líquido → raízes -->
  <svg id="tp-tree-svg" aria-hidden="true" preserveAspectRatio="none"
       style="position:absolute; inset:0; width:100%; height:100%; z-index:1; pointer-events:none;">
    <defs>
      <linearGradient id="tp-gold" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1000">
        <stop offset="0"    stop-color="#EBCE8A"></stop>
        <stop offset="0.38" stop-color="#D3A257"></stop>
        <stop offset="0.72" stop-color="#B47C43"></stop>
        <stop offset="1"    stop-color="#8E5A31"></stop>
      </linearGradient>
      <linearGradient id="tp-gold-bright" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1000">
        <stop offset="0" stop-color="#F6E4B4"></stop>
        <stop offset="1" stop-color="#D9B67A"></stop>
      </linearGradient>
      <radialGradient id="tp-bloom-glow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0"   stop-color="#E7C57F" stop-opacity="0.55"></stop>
        <stop offset="0.6" stop-color="#B7905B" stop-opacity="0.18"></stop>
        <stop offset="1"   stop-color="#B7905B" stop-opacity="0"></stop>
      </radialGradient>
      <clipPath id="tp-tree-clip" clipPathUnits="userSpaceOnUse">
        <rect id="tp-tree-clip-rect" x="0" y="0" width="8000" height="0"></rect>
      </clipPath>
    </defs>
    <g clip-path="url(#tp-tree-clip)">
      <circle id="tp-bloom-halo" fill="url(#tp-bloom-glow)" cx="0" cy="0" r="0" opacity="0.9"></circle>
      <path id="tp-trunk-ribbon" fill="url(#tp-gold)" d="" opacity="0.07"></path>
      <path id="tp-trunk-edge"   fill="none" stroke="url(#tp-gold)" stroke-linecap="round" opacity="0.16" d=""></path>
      <g    id="tp-fibers"       fill="none" stroke="url(#tp-gold)" stroke-linecap="round"></g>
      <path id="tp-vein"         fill="none" stroke="url(#tp-gold)" stroke-linecap="round" opacity="0.4" d=""></path>
      <g    id="tp-tendrils"     fill="url(#tp-gold)" opacity="0.6"></g>
      <g    id="tp-beads"        fill="#C79A5A"></g>
      <g id="tp-roots"      fill="url(#tp-gold)"  opacity="0.72"></g>
      <g id="tp-root-veins" fill="none" stroke="url(#tp-gold-bright)" stroke-linecap="round" opacity="0.4"></g>
      <g id="tp-rootnodes"  fill="#E7C57F" opacity="0.85"></g>
    </g>
  </svg>

  <img id="tp-sunmoon" src="/assets/sol-lua.webp" alt="" aria-hidden="true" width="204" height="204" decoding="async"
       style="position:absolute; z-index:1; pointer-events:none; width:clamp(78px,19vw,128px); height:auto; left:86%; top:30px; transform:translateX(-50%); opacity:0.94;">
  <!-- Bonequinho: tira de 9 quadros (adulto → criança). Trocar o quadro conforme
       ele desce faz o corpo encurtar de verdade; cruzar duas imagens por opacidade
       mostraria as duas silhuetas ao mesmo tempo (efeito fantasma). A imagem é
       atribuída pelo script só quando ele começa a aparecer, pra não competir com
       o carregamento do topo. Gerada por scripts/gera-morph-menino.py. -->
  <div id="tp-boy" aria-hidden="true" data-quadros="9"
       style="position:absolute; z-index:1; pointer-events:none; width:clamp(22px,5.2vw,36px); aspect-ratio:303/976; left:0; top:0; transform:translate(-50%,-95%); opacity:0;
              background-repeat:no-repeat; background-size:900% 100%; background-position:0% 0;"></div>

  <!-- 1) HERO -->
  <header id="inicio" data-screen-label="Hero" style="min-height:100vh; background:var(--marrom); display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; padding:96px 30px 80px;">
    <div style="position:relative; z-index:2; display:flex; flex-direction:column; align-items:center;">
    <img src="/assets/selo.webp" alt="Selo da Taphiny · Visão Sistêmica e Constelação Familiar" width="118" height="118" fetchpriority="high" decoding="async" style="width:118px; height:118px; border-radius:50%; margin-bottom:38px;">
    <div style="font-family:'Playfair Display',serif; font-weight:400; font-size:26px; letter-spacing:0.42em; color:var(--rosa); padding-left:0.42em;">{hero.marca}</div>
    <div style="font-family:'Montserrat',sans-serif; font-weight:400; font-size:10px; letter-spacing:0.42em; text-transform:uppercase; color:var(--ouro); margin-top:16px;">{hero.subtitulo}</div>
    <h1 style="font-family:'Playfair Display',serif; font-weight:400; font-size:34px; line-height:1.25; color:var(--creme); max-width:600px; margin-top:52px; text-wrap:balance;">{hero.titulo}</h1>
    <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:15px; line-height:2; color:var(--rosa); max-width:440px; margin-top:30px; text-wrap:pretty;" set:html={t(hero.paragrafo)}></p>
    <p class="tp-citacao" style="font-size:19px; color:var(--ouroc); max-width:440px; margin-top:34px;" set:html={t(hero.frase)}></p>
    <a href={wa(config.mensagemConversa)} target="_blank" rel="noopener" class="tp-btn" style="display:inline-block; margin-top:48px; font-family:'Montserrat',sans-serif; font-size:12px; letter-spacing:0.24em; text-transform:uppercase; color:var(--marrom); background:var(--ouro); text-decoration:none; padding:17px 38px;">{hero.cta}</a>
    <div style="margin-top:70px; width:1px; height:52px; background:linear-gradient(var(--ouro),transparent);"></div>
    </div>
  </header>

  <main id="conteudo">

  <!-- 2) AUTOCONSCIÊNCIA: abertura, contraste em duas colunas, três cartões
       numerados (os pilares da maturidade) e a frase de fechamento -->
  {mostra('provocacao') && (
  <section id="o-que-carregamos" data-screen-label="Provocacao" class={`tp-fundo-${fundos.provocacao}`} style={`${fundo('provocacao')} padding:110px 30px;`}>
    <div data-reveal class="tp-larga" style="position:relative; z-index:2;">
      <Bloco blocado={blocado} centro>
      <Fragment slot="cabeca">
      <div style="font-family:'Montserrat',sans-serif; font-size:11px; letter-spacing:0.3em; text-transform:uppercase; color:var(--bordeaux); text-align:center; margin-bottom:24px;">{provocacao.rotulo}</div>
      <h2 style="font-family:'Playfair Display',serif; font-weight:400; font-size:30px; line-height:1.35; color:var(--marrom); text-align:center; max-width:560px; margin:0 auto 32px; text-wrap:balance;">{provocacao.titulo}</h2>
      </Fragment>
      <p class="tp-abertura" set:html={t(provocacao.abertura)}></p>
      <div class="tp-contraste tp-espaco">
        <div class="tp-contraste-col fraca">
          <h3 class="tp-contraste-tit">{provocacao.col1Titulo}</h3>
          <p set:html={t(provocacao.col1Texto)}></p>
        </div>
        <div class="tp-contraste-col forte">
          <h3 class="tp-contraste-tit">{provocacao.col2Titulo}</h3>
          <p set:html={t(provocacao.col2Texto)}></p>
        </div>
      </div>
      <div class="tp-espaco">
        <h3 class="tp-subtit">{provocacao.pilaresTitulo}</h3>
        <ol class="tp-num-cards">
          {(provocacao.pilares || []).map((c, i) => (
          <li class="tp-num-card">
            <span class="tp-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h4>{c.titulo}</h4>
            <p set:html={t(c.texto)}></p>
          </li>
          ))}
        </ol>
      </div>
      <p class="tp-citacao tp-fecho tp-espaco" set:html={t(provocacao.fecho)}></p>
      </Bloco>
    </div>
  </section>
  )}

  <!-- 2b) MINHA ABORDAGEM: abertura, chips das áreas da vida, bloco em
       destaque, linha do tempo do processo e frase de fechamento -->
  {abordagem && mostra('abordagem') && (
  <section id="minha-abordagem" data-screen-label="MinhaAbordagem" class={`tp-fundo-${fundos.abordagem}`} style={`${fundo('abordagem')} padding:110px 30px;`}>
    <div data-reveal class="tp-larga" style="position:relative; z-index:2;">
      <Bloco blocado={blocado} centro>
      <Fragment slot="cabeca">
      <div style="font-family:'Montserrat',sans-serif; font-size:11px; letter-spacing:0.3em; text-transform:uppercase; color:var(--bordeaux); text-align:center; margin-bottom:24px;">{abordagem.rotulo}</div>
      <h2 style="font-family:'Playfair Display',serif; font-weight:400; font-size:30px; line-height:1.35; color:var(--marrom); text-align:center; max-width:560px; margin:0 auto 32px; text-wrap:balance;">{abordagem.titulo}</h2>
      </Fragment>
      <p class="tp-abertura" set:html={t(abordagem.abertura)}></p>
      {(abordagem.chips || []).length > 0 && (
      <div class="tp-espaco">
        <div class="tp-rotulo-mini">{abordagem.chipsTitulo}</div>
        <ul class="tp-chips">
          {abordagem.chips.map((c) => (<li>{c}</li>))}
        </ul>
      </div>
      )}
      <p class="tp-citacao tp-destaque tp-espaco" set:html={t(abordagem.destaque)}></p>
      <div class="tp-espaco">
        <h3 class="tp-subtit">{abordagem.etapasTitulo}</h3>
        <ol class="tp-etapas" style={`--n:${(abordagem.etapas || []).length || 1};`}>
          {(abordagem.etapas || []).map((e, i) => (
          <li>
            <span class="tp-etapa-bola" aria-hidden="true">{i + 1}</span>
            <h4>{e.titulo}</h4>
            <p set:html={t(e.texto)}></p>
          </li>
          ))}
        </ol>
      </div>
      <p class="tp-citacao tp-fecho tp-espaco" set:html={t(abordagem.fecho)}></p>
      </Bloco>
    </div>
  </section>
  )}

  <!-- 3) O QUE É A VISÃO SISTÊMICA: abertura, o que ela não é x o que faz, os
       três pilares, a frase grande e o fechamento. Fundo creme para alternar
       com a Minha abordagem (rosa) logo acima. -->
  {mostra('visao') && (
  <section id="visao-sistemica" data-screen-label="VisaoSistemica" class={`tp-fundo-${fundos.visao}`} style={`${fundo('visao')} padding:110px 30px;`}>
    <div data-reveal class="tp-larga" style="position:relative; z-index:2;">
      <Bloco blocado={blocado} centro>
      <Fragment slot="cabeca">
      <div style="font-family:'Montserrat',sans-serif; font-size:11px; letter-spacing:0.3em; text-transform:uppercase; color:var(--bordeaux); text-align:center; margin-bottom:24px;">{visao.rotulo}</div>
      <h2 style="font-family:'Playfair Display',serif; font-weight:400; font-size:30px; line-height:1.35; color:var(--marrom); text-align:center; max-width:560px; margin:0 auto 32px; text-wrap:balance;">{visao.titulo}</h2>
      </Fragment>
      <p class="tp-abertura" set:html={t(visao.abertura)}></p>
      <div class="tp-contraste tp-espaco">
        <div class="tp-contraste-col fraca">
          <h3 class="tp-contraste-tit">{visao.col1Titulo}</h3>
          <ul>{(visao.col1 || []).map((item) => (<li set:html={t(item)}></li>))}</ul>
        </div>
        <div class="tp-contraste-col forte">
          <h3 class="tp-contraste-tit">{visao.col2Titulo}</h3>
          <ul>{(visao.col2 || []).map((item) => (<li set:html={t(item)}></li>))}</ul>
        </div>
      </div>
      <div class="tp-espaco"></div>
      <!-- PILARES: três cartões de cor sólida, todos à vista. O símbolo segue o
           índice: 0 = Pertencimento (um círculo que acolhe os outros),
           1 = Ordem (cada um no seu lugar), 2 = Equilíbrio (a vida correndo). -->
      <div class="tp-pil-cards">
        {visao.pilares.map((p, i) => (
        <div class:list={['tp-pil-card', `cor-${i % 3}`]}>
          <svg class="tp-pil-icone" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
            {i % 3 === 0 && (<>
              <circle cx="24" cy="24" r="16"></circle>
              <circle cx="18" cy="21" r="3.4" fill="currentColor" stroke="none" opacity="0.9"></circle>
              <circle cx="29" cy="19" r="2.6" fill="currentColor" stroke="none" opacity="0.7"></circle>
              <circle cx="25" cy="30" r="3" fill="currentColor" stroke="none" opacity="0.8"></circle>
            </>)}
            {i % 3 === 1 && (<>
              <line x1="10" y1="34" x2="38" y2="34"></line>
              <circle cx="15" cy="26" r="4.2" fill="currentColor" stroke="none" opacity="0.9"></circle>
              <circle cx="24" cy="23" r="3.4" fill="currentColor" stroke="none" opacity="0.75"></circle>
              <circle cx="33" cy="20" r="2.6" fill="currentColor" stroke="none" opacity="0.6"></circle>
            </>)}
            {i % 3 === 2 && (<>
              <path d="M9 19c5-5 9 5 15 0s10 5 15 0"></path>
              <path d="M9 29c5-5 9 5 15 0s10 5 15 0" opacity="0.6"></path>
            </>)}
          </svg>
          <h3 class="tp-pil-tit">{p.titulo}</h3>
          <p set:html={t(p.texto)}></p>
        </div>
        ))}
      </div>
      <p class="tp-citacao tp-fecho grande tp-espaco" set:html={t(visao.destaque)}></p>
      <p class="tp-abertura" style="margin-top:28px;" set:html={t(visao.fecho)}></p>
      </Bloco>
    </div>
  </section>
  )}

  <!-- 4) QUEM CONDUZ -->
  {mostra('quemConduz') && (
  <article id="quem-conduz" data-screen-label="QuemConduz" class={`tp-fundo-${fundos.quemConduz}`} style={`${fundo('quemConduz')} padding:110px 30px;`}>
    <div data-reveal style="position:relative; z-index:2; max-width:560px; margin:0 auto;">
      <Bloco blocado={blocado} centro>
      <Fragment slot="midia">
      <figure id="tp-retrato" style="margin:0 0 48px; width:100%; aspect-ratio:4/5; border:1px solid var(--ouro); overflow:hidden; position:relative; background-color:#3A0D0F;">
        {quemConduz.video ? (
          <VideoMidia arquivo={quemConduz.video} capa={quemConduz.videoCapa} titulo="Taphiny, Mentora Sistêmica" />
        ) : quemConduz.foto ? (
          <img src={quemConduz.foto} alt="Taphiny, Mentora Sistêmica" style="width:100%; height:100%; object-fit:cover; display:block;">
        ) : (
          <div id="tp-retrato-ph" style="position:absolute; inset:0; display:flex; align-items:flex-end; justify-content:center; padding:20px; background-image:repeating-linear-gradient(135deg, rgba(215,182,122,0.12) 0px, rgba(215,182,122,0.12) 1px, transparent 1px, transparent 12px);">
            <span style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--ouroc);">foto ou vídeo · 4:5</span>
          </div>
        )}
      </figure>
      </Fragment>
      <Fragment slot="cabeca">
      <div style="font-family:'Montserrat',sans-serif; font-size:11px; letter-spacing:0.3em; text-transform:uppercase; color:var(--ouroc); text-align:center; margin-bottom:28px;">{quemConduz.rotulo}</div>
      <h2 style="font-family:'Playfair Display',serif; font-style:italic; font-weight:400; font-size:25px; line-height:1.45; color:var(--creme); text-align:center; margin-bottom:30px; text-wrap:pretty;">{quemConduz.titulo}</h2>
      </Fragment>
