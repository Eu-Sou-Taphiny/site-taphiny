</div>

<!-- POP-UP DE ENTRADA (aparece só se "ativo" no painel; 1x por sessão) -->
{popup?.ativo && (
  <div id="tp-popup-overlay" role="presentation" style="display:none; position:fixed; inset:0; z-index:80; background:rgba(58,13,15,0.62); -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px); align-items:center; justify-content:center; padding:22px;">
    <div id="tp-popup" role="dialog" aria-modal="true" style="position:relative; background:var(--creme); color:var(--marrom); max-width:440px; width:100%; border-radius:18px; box-shadow:0 24px 70px rgba(0,0,0,0.4); overflow:hidden; text-align:center; transform:translateY(12px) scale(0.98); opacity:0; transition:transform .4s ease, opacity .4s ease;">
      <button id="tp-popup-close" type="button" aria-label="Fechar" style="position:absolute; top:12px; right:14px; width:32px; height:32px; border:none; background:rgba(0,0,0,0.07); color:var(--marrom); border-radius:50%; font-size:20px; line-height:1; cursor:pointer; z-index:1;">×</button>
