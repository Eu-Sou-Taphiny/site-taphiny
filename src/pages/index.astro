---
import site from '../content/site.json';
import SiteFooter from '../components/SiteFooter.astro';
const { seo, hero, provocacao, visao, quemConduz, comparacao, jornadas, paraQuem, faq, empresas, convite, config } = site;
const popup = (site as any).popup;
const wa = (msg: string) => `https://wa.me/${config.whatsapp}?text=${encodeURIComponent(msg)}`;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{seo.titulo}</title>
<meta name="description" content={seo.descricao}>
<meta name="author" content="Taphiny">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="keywords" content="visão sistêmica, terapia sistêmica, constelação familiar, terapia sistêmica para empresas familiares, padrões familiares transgeracionais, mentoria sistêmica">
<link rel="canonical" href="https://www.eusoutaphiny.com.br/">
<meta name="theme-color" content="#521416">

<!-- Google Search Console: verificado por registro TXT no DNS (propriedade de domínio). -->

<!-- Open Graph (WhatsApp, Instagram, Facebook, LinkedIn) -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Taphiny — Visão Sistêmica">
<meta property="og:title" content={seo.titulo}>
<meta property="og:description" content="Um caminho de terapia sistêmica que dialoga com a constelação familiar para reconhecer padrões transgeracionais e restaurar a ordem da vida.">
<meta property="og:locale" content="pt_BR">
<meta property="og:url" content="https://www.eusoutaphiny.com.br/">
<meta property="og:image" content="https://www.eusoutaphiny.com.br/assets/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Selo da Taphiny — Visão Sistêmica e Constelação Familiar">

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={seo.titulo}>
<meta name="twitter:description" content="Terapia sistêmica que dialoga com a constelação familiar para reconhecer padrões transgeracionais e restaurar a ordem da vida.">
<meta name="twitter:image" content="https://www.eusoutaphiny.com.br/assets/og-image.png">

<!-- Favicons -->
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">

<!-- Fontes -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet">
<link rel="preload" as="image" href="/assets/selo.webp">

<style is:global>
  :root{
    --creme:#F6F1EA; --rosa:#DCC4BB; --areia:#BFA79A; --marrom:#521416;
    --bordeaux:#6A3F4B; --terracota:#A56E5F; --ouro:#B7905B; --ouroc:#D9B67A;
    --marrom-escuro:#3A0D0F;
  }
  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{ background:var(--marrom); -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; overflow-x:hidden; }
  img{ display:block; max-width:100%; }
  a{ color:var(--ouro); }
  a:hover{ color:var(--ouroc); }
  :focus-visible{ outline:2px solid var(--ouroc); outline-offset:3px; border-radius:2px; }
  ::selection{ background:var(--ouro); color:var(--creme); }
  @media (prefers-reduced-motion: reduce){ html{ scroll-behavior:auto; } }
  .tp-corp:hover{ background:var(--marrom) !important; color:var(--ouroc) !important; border-color:var(--marrom) !important; }
  .tp-btn{ transition:opacity .4s; }
  .tp-btn:hover{ opacity:.85; }
</style>

<!-- DADOS ESTRUTURADOS (schema.org / JSON-LD) -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://www.eusoutaphiny.com.br/#website", "url": "https://www.eusoutaphiny.com.br/", "name": "Taphiny — Visão Sistêmica", "description": "Visão Sistêmica, terapia sistêmica e constelação familiar com Taphiny.", "inLanguage": "pt-BR", "publisher": { "@id": "https://www.eusoutaphiny.com.br/#business" }, "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://www.eusoutaphiny.com.br/?s={search_term_string}" }, "query-input": "required name=search_term_string" } },
    { "@type": "Person", "@id": "https://www.eusoutaphiny.com.br/#taphiny", "name": "Taphiny", "jobTitle": "Mentora Sistêmica", "description": "Terapeuta e mentora sistêmica. Conduz processos de Visão Sistêmica e constelação familiar para reconhecer padrões familiares transgeracionais, restaurar a ordem dos vínculos e permitir que a vida volte a fluir.", "knowsAbout": ["Visão Sistêmica", "Terapia Sistêmica", "Constelação Familiar", "Padrões familiares transgeracionais", "Empresas familiares"], "url": "https://www.eusoutaphiny.com.br/", "worksFor": { "@id": "https://www.eusoutaphiny.com.br/#business" }, "sameAs": ["https://instagram.com/eu.sou.taphiny"] },
    { "@type": "ProfessionalService", "@id": "https://www.eusoutaphiny.com.br/#business", "name": "Taphiny — Visão Sistêmica", "description": "Terapia sistêmica e Visão Sistêmica, abordagem que dialoga com a constelação familiar para reconhecer padrões familiares transgeracionais e restaurar a ordem dos vínculos. Atendimento a pessoas, empresas familiares e eventos.", "url": "https://www.eusoutaphiny.com.br/", "image": "https://www.eusoutaphiny.com.br/assets/og-image.png", "logo": "https://www.eusoutaphiny.com.br/assets/favicon-512.png", "founder": { "@id": "https://www.eusoutaphiny.com.br/#taphiny" }, "priceRange": "$$", "areaServed": "BR", "availableLanguage": "Portuguese", "knowsLanguage": "pt-BR", "keywords": "visão sistêmica, terapia sistêmica, constelação familiar, terapia sistêmica para empresas familiares, padrões familiares transgeracionais", "sameAs": ["https://instagram.com/eu.sou.taphiny"], "makesOffer": [ { "@type": "Offer", "itemOffered": { "@id": "https://www.eusoutaphiny.com.br/#servico-sessao" }, "price": "450", "priceCurrency": "BRL" }, { "@type": "Offer", "itemOffered": { "@id": "https://www.eusoutaphiny.com.br/#servico-essencia" } }, { "@type": "Offer", "itemOffered": { "@id": "https://www.eusoutaphiny.com.br/#servico-raizes" } }, { "@type": "Offer", "itemOffered": { "@id": "https://www.eusoutaphiny.com.br/#servico-negocios" } }, { "@type": "Offer", "itemOffered": { "@id": "https://www.eusoutaphiny.com.br/#servico-workshops" } } ] },
    { "@type": "Service", "@id": "https://www.eusoutaphiny.com.br/#servico-sessao", "name": "Sessão Sistêmica (Olhar)", "serviceType": "Terapia Sistêmica", "description": "Encontro individual direcionado a um tema específico — uma decisão, um relacionamento, carreira, dinheiro ou um padrão que se repete. Ideal para quem busca clareza sobre um momento.", "provider": { "@id": "https://www.eusoutaphiny.com.br/#business" }, "areaServed": "BR", "offers": { "@type": "Offer", "price": "450", "priceCurrency": "BRL" } },
    { "@type": "Service", "@id": "https://www.eusoutaphiny.com.br/#servico-essencia", "name": "Jornada Essência", "serviceType": "Terapia Sistêmica", "description": "Quatro encontros para reorganizar o eixo interno, fortalecer o lugar de adulto e construir uma vida mais alinhada com quem realmente se é.", "provider": { "@id": "https://www.eusoutaphiny.com.br/#business" }, "areaServed": "BR" },
    { "@type": "Service", "@id": "https://www.eusoutaphiny.com.br/#servico-raizes", "name": "Jornada Raízes", "serviceType": "Constelação Familiar", "description": "Sete encontros de investigação profunda das dinâmicas familiares e dos padrões transgeracionais, no espírito da constelação familiar, para recuperar a força necessária para construir o futuro.", "provider": { "@id": "https://www.eusoutaphiny.com.br/#business" }, "areaServed": "BR" },
    { "@type": "Service", "@id": "https://www.eusoutaphiny.com.br/#servico-negocios", "name": "Terapias para Negócios", "serviceType": "Terapia Sistêmica para empresas familiares", "description": "Visão Sistêmica aplicada a empresas familiares, relação entre sócios, liderança e equipes, trabalhando pertencimento, cultura e prosperidade.", "provider": { "@id": "https://www.eusoutaphiny.com.br/#business" }, "areaServed": "BR" },
    { "@type": "Service", "@id": "https://www.eusoutaphiny.com.br/#servico-workshops", "name": "Workshops & Palestras", "serviceType": "Terapia Sistêmica", "description": "Workshops e palestras sobre Visão Sistêmica, pertencimento, cultura e prosperidade para empresas e eventos.", "provider": { "@id": "https://www.eusoutaphiny.com.br/#business" }, "areaServed": "BR" },
    { "@type": "FAQPage", "@id": "https://www.eusoutaphiny.com.br/#faq", "mainEntity": [
      { "@type": "Question", "name": "O que é Visão Sistêmica?", "acceptedAnswer": { "@type": "Answer", "text": "A Visão Sistêmica é uma abordagem terapêutica que enxerga a pessoa dentro dos sistemas a que pertence — família, vínculos e história. Ela parte do princípio de que nem tudo o que vivemos começou em nós: muitos padrões, lealdades e bloqueios são herdados ao longo das gerações. O trabalho reconhece essas dinâmicas para restaurar a ordem dos vínculos e permitir que a vida volte a fluir." } },
      { "@type": "Question", "name": "Visão Sistêmica é a mesma coisa que constelação familiar?", "acceptedAnswer": { "@type": "Answer", "text": "São práticas irmãs, da mesma raiz. A constelação familiar é uma das ferramentas mais conhecidas da abordagem sistêmica, geralmente feita em grupo, enquanto a Visão Sistêmica é o olhar mais amplo que fundamenta esse trabalho e pode ser conduzido também de forma individual. Quem busca constelação familiar encontra aqui esse mesmo princípio, aplicado de maneira profunda e personalizada." } },
      { "@type": "Question", "name": "Qual a diferença entre psicoterapia e Visão Sistêmica?", "acceptedAnswer": { "@type": "Answer", "text": "Não são caminhos opostos, e sim complementares. A psicoterapia amplia a consciência sobre a experiência individual — pensamentos, emoções e comportamentos. A Visão Sistêmica observa a pessoa dentro dos sistemas a que pertence, revelando lealdades invisíveis e dinâmicas familiares para restaurar a ordem dos vínculos." } },
      { "@type": "Question", "name": "Como funciona uma sessão?", "acceptedAnswer": { "@type": "Answer", "text": "Cada encontro é individual e direcionado a um tema específico: uma decisão, um relacionamento, a carreira, o dinheiro ou um padrão que se repete. Em um espaço seguro, aquilo que permaneceu invisível é reconhecido, respeitado e reorganizado. A Sessão Sistêmica (Olhar) parte de R$ 450 por encontro, e há também jornadas mais profundas, como a Essência e a Raízes." } },
      { "@type": "Question", "name": "Para quem é indicado?", "acceptedAnswer": { "@type": "Answer", "text": "É indicado para quem percebe padrões que se repetem, sente que compreender já não basta e deseja ocupar o próprio lugar com mais leveza. Também se aplica a empresas familiares, relação entre sócios e liderança. Não é indicado para quem busca soluções imediatas ou espera que o caminho seja feito por outra pessoa." } }
    ] },
    { "@type": "BreadcrumbList", "@id": "https://www.eusoutaphiny.com.br/#breadcrumb", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Início", "item": "https://www.eusoutaphiny.com.br/" },
      { "@type": "ListItem", "position": 2, "name": "Visão Sistêmica", "item": "https://www.eusoutaphiny.com.br/#visao-sistemica" },
      { "@type": "ListItem", "position": 3, "name": "As Jornadas", "item": "https://www.eusoutaphiny.com.br/#jornadas" },
      { "@type": "ListItem", "position": 4, "name": "Perguntas Frequentes", "item": "https://www.eusoutaphiny.com.br/#faq" }
    ] }
  ]
}
</script>

<!-- Google Analytics 4 -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H58M107G7T"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-H58M107G7T');
</script>
</head>
<body>

<div id="tp-page" style="position:relative; font-family:'Montserrat',sans-serif; color:var(--marrom);">

  <!-- ÁRVORE ASSINATURA: sol/lua → tronco de ouro líquido → raízes -->
  <svg id="tp-tree-svg" aria-hidden="true" preserveAspectRatio="none"
       style="position:absolute; inset:0; width:100%; height:100%; z-index:1; pointer-events:none;">
    <defs>
      <linearGradient id="tp-gold" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1000">
        <stop offset="0"    stop-color="#EBCE8A"></stop>
        <stop offset="0.38" stop-color="#D3A257"></stop>
        <stop offset="0.72" stop-color="#B47C43"></stop>
        <stop offset="1"    stop-color="#8E5A31"></stop>
      </linearGradient>
      <linearGradient id="tp-gold-bright" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1000">
        <stop offset="0" stop-color="#F6E4B4"></stop>
        <stop offset="1" stop-color="#D9B67A"></stop>
      </linearGradient>
      <radialGradient id="tp-bloom-glow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0"   stop-color="#E7C57F" stop-opacity="0.55"></stop>
        <stop offset="0.6" stop-color="#B7905B" stop-opacity="0.18"></stop>
        <stop offset="1"   stop-color="#B7905B" stop-opacity="0"></stop>
      </radialGradient>
      <clipPath id="tp-tree-clip" clipPathUnits="userSpaceOnUse">
        <rect id="tp-tree-clip-rect" x="0" y="0" width="8000" height="0"></rect>
      </clipPath>
    </defs>
    <g clip-path="url(#tp-tree-clip)">
      <circle id="tp-bloom-halo" fill="url(#tp-bloom-glow)" cx="0" cy="0" r="0" opacity="0.9"></circle>
      <path id="tp-trunk-ribbon" fill="url(#tp-gold)" d="" opacity="0.07"></path>
      <path id="tp-trunk-edge"   fill="none" stroke="url(#tp-gold)" stroke-linecap="round" opacity="0.16" d=""></path>
      <g    id="tp-fibers"       fill="none" stroke="url(#tp-gold)" stroke-linecap="round"></g>
      <path id="tp-vein"         fill="none" stroke="url(#tp-gold)" stroke-linecap="round" opacity="0.4" d=""></path>
      <g    id="tp-tendrils"     fill="url(#tp-gold)" opacity="0.6"></g>
      <g    id="tp-beads"        fill="#C79A5A"></g>
      <g id="tp-roots"      fill="url(#tp-gold)"  opacity="0.72"></g>
      <g id="tp-root-veins" fill="none" stroke="url(#tp-gold-bright)" stroke-linecap="round" opacity="0.4"></g>
      <g id="tp-rootnodes"  fill="#E7C57F" opacity="0.85"></g>
    </g>
  </svg>

  <img id="tp-sunmoon" src="/assets/sol-lua.webp" alt="" aria-hidden="true" width="204" height="204" decoding="async"
       style="position:absolute; z-index:1; pointer-events:none; width:clamp(78px,19vw,128px); height:auto; left:86%; top:30px; transform:translateX(-50%); opacity:0.94;">
  <img id="tp-boy" src="/assets/menino.webp" alt="" aria-hidden="true" width="303" height="976" loading="lazy" decoding="async"
       style="position:absolute; z-index:1; pointer-events:none; width:clamp(22px,5.2vw,36px); height:auto; left:0; top:0; transform:translate(-50%,-95%); opacity:0;">

  <!-- 1) HERO -->
  <header id="inicio" data-screen-label="Hero" style="min-height:100vh; background:var(--marrom); display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; padding:96px 30px 80px;">
    <div style="position:relative; z-index:2; display:flex; flex-direction:column; align-items:center;">
    <img src="/assets/selo.webp" alt="Selo da Taphiny — Visão Sistêmica e Constelação Familiar" width="118" height="118" fetchpriority="high" decoding="async" style="width:118px; height:118px; border-radius:50%; margin-bottom:38px;">
    <div style="font-family:'Playfair Display',serif; font-weight:400; font-size:26px; letter-spacing:0.42em; color:var(--rosa); padding-left:0.42em;">{hero.marca}</div>
    <div style="font-family:'Montserrat',sans-serif; font-weight:400; font-size:10px; letter-spacing:0.42em; text-transform:uppercase; color:var(--ouro); margin-top:16px;">{hero.subtitulo}</div>
    <h1 style="font-family:'Playfair Display',serif; font-weight:400; font-size:34px; line-height:1.25; color:var(--creme); max-width:600px; margin-top:52px; text-wrap:balance;">{hero.titulo}</h1>
    <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:15px; line-height:2; color:var(--rosa); max-width:440px; margin-top:30px; text-wrap:pretty;">{hero.paragrafo}</p>
    <p style="font-family:'Playfair Display',serif; font-style:italic; font-weight:400; font-size:17px; line-height:1.7; color:var(--ouroc); max-width:400px; margin-top:34px; text-wrap:pretty;">{hero.frase}</p>
    <a href={wa(config.mensagemConversa)} target="_blank" rel="noopener" class="tp-btn" style="display:inline-block; margin-top:48px; font-family:'Montserrat',sans-serif; font-size:12px; letter-spacing:0.24em; text-transform:uppercase; color:var(--marrom); background:var(--ouro); text-decoration:none; padding:17px 38px;">{hero.cta}</a>
    <div style="margin-top:70px; width:1px; height:52px; background:linear-gradient(var(--ouro),transparent);"></div>
    </div>
  </header>

  <main id="conteudo">

  <!-- 2) A PROVOCAÇÃO -->
  <section id="o-que-carregamos" data-screen-label="Provocacao" style="background:var(--creme); padding:110px 30px;">
    <div data-reveal style="position:relative; z-index:2; max-width:560px; margin:0 auto;">
      <div style="font-family:'Montserrat',sans-serif; font-size:11px; letter-spacing:0.3em; text-transform:uppercase; color:var(--terracota); margin-bottom:36px;">{provocacao.rotulo}</div>
      <h2 style="font-family:'Playfair Display',serif; font-weight:400; font-size:30px; line-height:1.35; color:var(--marrom); max-width:480px; margin-bottom:40px; text-wrap:balance;">{provocacao.titulo}</h2>
      <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:16px; line-height:2; color:var(--marrom); margin-bottom:26px; text-wrap:pretty;">{provocacao.paragrafo1}</p>
      <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:16px; line-height:2; color:var(--marrom); text-wrap:pretty;">{provocacao.paragrafo2}</p>
    </div>
  </section>

  <!-- 3) A ABORDAGEM -->
  <section id="visao-sistemica" data-screen-label="Abordagem" style="background:var(--rosa); padding:110px 30px;">
    <div data-reveal style="position:relative; z-index:2; max-width:620px; margin:0 auto;">
      <div style="font-family:'Montserrat',sans-serif; font-size:11px; letter-spacing:0.3em; text-transform:uppercase; color:var(--bordeaux); margin-bottom:24px;">{visao.rotulo}</div>
      <h2 style="font-family:'Playfair Display',serif; font-weight:400; font-size:30px; line-height:1.35; color:var(--marrom); max-width:520px; margin-bottom:28px; text-wrap:balance;">{visao.titulo}</h2>
      <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:16px; line-height:2; color:var(--marrom); max-width:520px; margin-bottom:26px; text-wrap:pretty;">{visao.definicao}</p>
      <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:16px; line-height:2; color:var(--marrom); max-width:520px; margin-bottom:64px; text-wrap:pretty;">{visao.paragrafo}</p>
      <div style="display:flex; flex-direction:column; gap:40px;">
        {visao.pilares.map((p) => (
        <div>
          <div style="font-family:'Playfair Display',serif; font-size:22px; color:var(--bordeaux); margin-bottom:10px;">{p.titulo}</div>
          <div style="width:32px; height:1px; background:var(--areia); margin-bottom:14px;"></div>
          <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:15px; line-height:1.9; color:var(--marrom);">{p.texto}</p>
        </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4) QUEM CONDUZ -->
  <article id="quem-conduz" data-screen-label="QuemConduz" style="background:var(--bordeaux); padding:110px 30px;">
    <div data-reveal style="position:relative; z-index:2; max-width:560px; margin:0 auto;">
      <figure id="tp-retrato" style="margin:0 0 48px; width:100%; aspect-ratio:4/5; border:1px solid var(--ouro); overflow:hidden; position:relative; background-color:#3A0D0F;">
        {quemConduz.video ? (
          <video src={quemConduz.video} poster={quemConduz.videoCapa || undefined} controls playsinline preload="metadata" style="width:100%; height:100%; object-fit:cover; display:block; background:#3A0D0F;"></video>
        ) : quemConduz.foto ? (
          <img src={quemConduz.foto} alt="Taphiny, Mentora Sistêmica" style="width:100%; height:100%; object-fit:cover; display:block;">
        ) : (
          <div id="tp-retrato-ph" style="position:absolute; inset:0; display:flex; align-items:flex-end; justify-content:center; padding:20px; background-image:repeating-linear-gradient(135deg, rgba(215,182,122,0.12) 0px, rgba(215,182,122,0.12) 1px, transparent 1px, transparent 12px);">
            <span style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--ouroc);">foto ou vídeo · 4:5</span>
          </div>
        )}
      </figure>
      <div style="font-family:'Montserrat',sans-serif; font-size:11px; letter-spacing:0.3em; text-transform:uppercase; color:var(--ouroc); margin-bottom:28px;">{quemConduz.rotulo}</div>
      <h2 style="font-family:'Playfair Display',serif; font-style:italic; font-weight:400; font-size:25px; line-height:1.45; color:var(--creme); margin-bottom:30px; text-wrap:pretty;">{quemConduz.titulo}</h2>
      <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:15px; line-height:2; color:var(--rosa); margin-bottom:24px; text-wrap:pretty;">{quemConduz.paragrafo1}</p>
      <p style="font-family:'Montserrat',sans-serif; font-weight:300; font-size:15px; line-height:2; color:var(--rosa); margin-bottom:24px; text-wrap:pretty;">{quemConduz.paragrafo2}</p>
