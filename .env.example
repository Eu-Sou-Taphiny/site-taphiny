# ============================================================
# TinaCMS — Tina Cloud
# Crie o projeto em https://app.tina.io, conecte ao repositório
# do GitHub (organização "Eu-Sou-Taphiny") e copie os valores.
# No desenvolvimento local, copie este arquivo para ".env".
# Na Vercel, cadastre estas variáveis em Project Settings → Environment Variables.
# ============================================================

# Client ID do projeto no Tina Cloud (público)
TINA_CLIENT_ID=

# Token de leitura (Read-Only Token) gerado no Tina Cloud
TINA_TOKEN=

# Branch que o Tina edita (normalmente "main")
TINA_BRANCH=main
